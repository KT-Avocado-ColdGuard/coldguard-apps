# 환경변수 우선 / 없으면 coldguard_config.py 기본값 사용. 파일 자체는 자동 로드하지 않습니다.
# 이 파일은 자동 로드되지 않습니다. 실제 환경변수/Secret으로 주입하세요.
SITE=site01
DEVICES=fz01
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_CA=/etc/coldguard/ca.crt
MQTT_USER=collector
MQTT_PASS=
MQTT_CLIENT_ID=collector-site01
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=coldguard
MYSQL_USER=collector
MYSQL_PASSWORD=
STATE_DB=/var/lib/coldguard/collector-site01.db
METRICS_HOST=0.0.0.0
METRICS_PORT=9201
STALE_SEC=
