# 통제 UI 환경변수 예시. API 키와 계정은 파일로 넣고 Git에 올리지 않는다.
# 표시된 기본값과 같으면 생략해도 된다.

# 통제 API 주소(필수). https, 경로 없이. 허브에서는 통제 API의 테일넷 주소를 넣는다.
CONTROL_API_URL=https://control-api.<tailnet>.ts.net

# kt-ui 키 한 줄만 든 파일. 권한 600, 주인은 컨테이너 사용자(uid 10001)
API_KEY_FILE=/etc/control-ui/api-key
# 계정 파일. 권한 600, 계정 도구로 만든다(control_ui/README.md)
ACCOUNTS_FILE=/etc/control-ui/accounts.json

# 데이터 단절 기준(초, 필수). 시설 collector·현장 웹의 STALE_SEC와 같은 값을 넣는다.
STALE_SEC=

# 장비별 Grafana 대시보드 주소. {site}와 {device} 자리에 시설·장비 ID가 들어간다. 비우면 링크를 숨긴다.
GRAFANA_DEVICE_URL=http://coldguard-kt-hub.<tailnet>.ts.net:3000/d/cg-dev?var-site={site}&var-device={device}

# /metrics (화면 포트와 분리). 허브 밖으로 내보내지 않고 같은 docker 네트워크의 Prometheus만 수집한다.
METRICS_HOST=0.0.0.0
METRICS_PORT=9205
