# 중앙 수집 워커 환경변수 예시. 실제 비밀번호는 쿠버네티스 Secret으로 넣고 Git에 올리지 않는다.
# 표시된 기본값과 같으면 생략해도 된다.

# 중앙 Mosquitto (클러스터 내부 1883, 평문)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=central-worker
MQTT_PASS=
MQTT_CLIENT_ID=central-worker

# 중앙 MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=coldguard_central
MYSQL_USER=coldguard_worker
MYSQL_PASSWORD=

# /metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=9203

# 측정 시각이 현재보다 이 초 이상 미래면 거부한다.
FUTURE_SKEW_SEC=300
