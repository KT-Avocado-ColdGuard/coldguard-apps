# 통제 API 환경변수 예시. 실제 비밀번호와 API 키는 쿠버네티스 Secret으로 넣고 Git에 올리지 않는다.
# 표시된 기본값과 같으면 생략해도 된다.

# 중앙 Mosquitto (클러스터 내부 1883, 평문). 발행만 하고 구독하지 않는다.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=control-api
MQTT_PASS=
# 파드마다 달라야 한다(필수). 배포에서는 파드 이름을 넣는다.
MQTT_CLIENT_ID=
# 로컬에서 TLS 브로커(8883)에 붙어 볼 때만 true로 하고 CA 파일 경로를 준다.
MQTT_TLS=false
MQTT_CA=

# 중앙 MySQL (조회 전체 + command_request 기록만 가능한 계정)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=coldguard_central
MYSQL_USER=coldguard_api
MYSQL_PASSWORD=

# 등록된 시설 목록(필수). 명령·조회 권한은 키마다 따로 준다.
SITES=site01,site02
# 명령 유효시간(초). 0보다 크고 300 이하. 시설 controller가 만료를 판정한다.
CMD_TTL_SEC=60

# API 키 파일(JSON 배열). 형식은 control_api/README.md 참고.
API_KEYS_FILE=/etc/control-api/keys.json

# /metrics (API 포트와 분리)
METRICS_HOST=0.0.0.0
METRICS_PORT=9204

# 로컬 실행(python -m control_api.app)에서만 쓴다. 배포는 gunicorn이 8000에서 받는다.
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8000
